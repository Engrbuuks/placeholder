# Connection used by the running app. This role must NOT own the tables, so row level security applies to it.
DATABASE_URL=postgres://placeholder_app:apppass@localhost:5432/placeholder

# Connection used only by "npm run migrate". This role owns the tables.
MIGRATION_DATABASE_URL=postgres://placeholder_owner:ownerpass@localhost:5432/placeholder

# Name of the app role above, so migrations can grant it access.
APP_DB_ROLE=placeholder_app

# Set to true on managed Postgres (Neon, Supabase) to require TLS.
DATABASE_SSL=false

# Optional. When set, the brand brain draft and niche matching use Claude. Without it, built in rules are used.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Full public address of the app, used in alert emails and the web chat code. No trailing slash.
APP_URL=http://localhost:3000

# Secret the scheduler sends as "Authorization: Bearer <CRON_SECRET>". At least 16 characters.
CRON_SECRET=

# 32 bytes, base64, for encrypting stored channel tokens. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# WhatsApp Cloud API (one Meta app for the whole platform; each business connects its own number).
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0

# Alert emails through Resend. Without these, alerts are logged and shown in the app only.
RESEND_API_KEY=
EMAIL_FROM=Placeholder <alerts@yourdomain.com>
